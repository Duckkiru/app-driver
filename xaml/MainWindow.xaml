                                Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Name="txtOptHardwareInfo" Text="Đang nhận diện phần cứng..."
                                       Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid Name="OptPageCustomize" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#0E131D" Padding="16,9" BorderBrush="#27344A" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <Button Name="btnOptApply" Content="Áp dụng đã chọn" Style="{StaticResource ActionButton}"
                                                Background="#059669" Padding="15,7"/>
                                        <Button Name="btnOptUndo" Content="Hoàn tác đã chọn" Style="{StaticResource SecondaryButton}"
                                                Foreground="#FBBF24" BorderBrush="#614F27"/>
                                        <Button Name="btnOptRestoreBackup" Content="Khôi phục sao lưu" Style="{StaticResource SecondaryButton}"
                                                Foreground="#38BDF8" BorderBrush="#29527D"/>
                                        <Button Name="btnOptRefresh" Content="Làm mới" Style="{StaticResource SecondaryButton}"
                                                Foreground="#38BDF8" BorderBrush="#29527D"/>
                                    </StackPanel>

                                    <Border Grid.Column="1" Background="#101520" CornerRadius="2" BorderBrush="#2E3D55" BorderThickness="1"
                                            Padding="8,0" Margin="10,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                                        <Grid Width="220">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,7,0" IsHitTestVisible="False"
                                                  Stroke="#64748B" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Data="M 7.7,7.7 L 11,11 M 8.8,5 A 3.8,3.8 0 1 1 1.2,5 A 3.8,3.8 0 1 1 8.8,5 Z"/>
                                            <TextBlock Grid.Column="1" Text="Tìm tweak..." Foreground="#475569" FontSize="11.5"
                                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=txtOptSearch}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="1" Name="txtOptSearch" Background="Transparent" Foreground="#F8FAFC"
                                                     BorderThickness="0" FontSize="12" VerticalAlignment="Center" CaretBrush="#38BDF8"
                                                     ToolTip="Tìm nhanh tweak theo tên hoặc mô tả..." ToolTipService.InitialShowDelay="3000"/>
                                            <Button Grid.Column="2" Name="btnClearOptSearch" Content="✕" Background="Transparent" Foreground="#64748B"
                                                    BorderThickness="0" FontSize="10" Cursor="Hand" Padding="2,0" VerticalAlignment="Center"
                                                    ToolTip="Xóa tìm kiếm" ToolTipService.InitialShowDelay="3000"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Name="btnOptSelectAll" Content="Chọn tất cả" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                                        <Button Name="btnOptDeselectAll" Content="Bỏ chọn" Style="{StaticResource SecondaryButton}" Margin="0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="1,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Preset:" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Border Background="#0B1019" BorderBrush="#263348" BorderThickness="1" CornerRadius="4" Padding="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Name="btnOptPresetDesktop" Content="PC Bàn chuẩn" Style="{StaticResource FilterTabButton}"/>
                                                <Button Name="btnOptPresetLaptop" Content="Laptop giữ pin" Style="{StaticResource FilterTabButton}"/>
                                                <Button Name="btnOptPresetGaming" Content="Gaming" Style="{StaticResource FilterTabButton}"/>
                                                <Button Name="btnOptPresetMinimal" Content="Tối giản" Style="{StaticResource FilterTabButton}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Lọc:" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                        <Border Background="#0B1019" BorderBrush="#263348" BorderThickness="1" CornerRadius="4" Padding="2" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Name="btnOptFilterAll" Content="Tất cả" Style="{StaticResource FilterTabButton}"
                                                        Background="#1C2A40" BorderBrush="#9938BDF8" Foreground="#38BDF8"/>
                                                <Button Name="btnOptFilterApplied" Content="Đang bật" Style="{StaticResource FilterTabButton}"/>
                                                <Button Name="btnOptFilterDefault" Content="Mặc định" Style="{StaticResource FilterTabButton}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Name="txtOptSummary" Text="72 tinh chỉnh sẵn sàng"
                                               Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="222"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0A0F18" BorderBrush="#27344A" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="12,10,12,6">
                                        <TextBlock Text="DANH MỤC TỐI ƯU" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <TextBlock Name="txtOptSidebarMeta" Text="6 nhóm · 72 mục" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="False" PanningMode="VerticalOnly" Padding="8,0,8,10">
                                        <StackPanel Name="OptSidebarPanel"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Column="1" Name="OptScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False" PanningMode="VerticalOnly" Padding="12,10">
                                <StackPanel Name="OptTweaksPanel"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Grid Name="OptPageResources" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#0A0E15" Padding="16,6" BorderBrush="#27344A" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Fill="#10B981" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Name="txtStatus" Text="Sẵn sàng"
                               Foreground="#93C5FD" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Name="btnCancelAction" Content="Dừng tác vụ" Visibility="Collapsed"
                            Background="#281317" Foreground="#FCA5A5" BorderBrush="#991B1B" BorderThickness="1"
                            FontSize="10.5" FontWeight="SemiBold" Height="22" Padding="9,0,9,1" Margin="12,0,0,0"
                            VerticalAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="3"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Name="borderQueueBadge" Visibility="Collapsed" Background="#172554" BorderBrush="#2563EB" BorderThickness="1"
                            CornerRadius="3" Height="22" Padding="8,0,8,1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Name="txtQueueBadge" Text="" Foreground="#93C5FD" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Name="txtSelectionCount" Text="0 app được chọn"
                               Foreground="#64748B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <ProgressBar Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                             Name="progressBar" Height="2" Margin="0,5,0,1"
                             Background="#141C2B" Foreground="#0EA5E9" BorderThickness="0" Value="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>